digraph ER {
graph [rankdir=LR, nodesep=0.25, ranksep=0.9, fontname="Helvetica", pad=0.2, dpi=220];
node [shape=plaintext, fontname="Helvetica", fontsize=11];
edge [color="#666666", arrowsize=0.8, fontname="Helvetica", fontsize=9];
sellers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#888888"><TR><TD COLSPAN="3" BGCOLOR="#E8E4FF"><B>SELLERS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="seller_id"><B>seller_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="seller_name">seller_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(100)</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="email">email</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(100)</FONT></TD><TD ALIGN="LEFT">UK</TD></TR><TR><TD ALIGN="LEFT" PORT="phone">phone</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(15)</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="address">address</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(150)</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="rating">rating</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">decimal(2,1)</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="joined_date">joined_date</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">date</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="password">password</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255)</FONT></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
products [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#888888"><TR><TD COLSPAN="3" BGCOLOR="#E8E4FF"><B>PRODUCTS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="product_id"><B>product_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="seller_id"><I>seller_id</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="gender">gender</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(20)</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="category">category</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(50)</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="sub_category">sub_category</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(50)</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="product_type">product_type</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(50)</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="colour">colour</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(30)</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="usage_type">usage_type</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(50)</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="product_title">product_title</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255)</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="image">image</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255)</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="image_url">image_url</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="brand">brand</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(100)</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="price">price</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">decimal(10,2)</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="stock_quantity">stock_quantity</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
customers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#888888"><TR><TD COLSPAN="3" BGCOLOR="#FFE9DE"><B>CUSTOMERS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="customer_id"><B>customer_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="first_name">first_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(50)</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="last_name">last_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(50)</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="email">email</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(100)</FONT></TD><TD ALIGN="LEFT">UK</TD></TR><TR><TD ALIGN="LEFT" PORT="password">password</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255)</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="phone">phone</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(15)</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="gender">gender</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(20)</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="city">city</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(50)</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="state">state</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(50)</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime</FONT></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
admin [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#888888"><TR><TD COLSPAN="3" BGCOLOR="#FFE9DE"><B>ADMIN</B></TD></TR><TR><TD ALIGN="LEFT" PORT="admin_id"><B>admin_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="username">username</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(50)</FONT></TD><TD ALIGN="LEFT">UK</TD></TR><TR><TD ALIGN="LEFT" PORT="password">password</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255)</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="email">email</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(100)</FONT></TD><TD ALIGN="LEFT">UK</TD></TR></TABLE>>];
cart [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#888888"><TR><TD COLSPAN="3" BGCOLOR="#DDF3EA"><B>CART</B></TD></TR><TR><TD ALIGN="LEFT" PORT="cart_id"><B>cart_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="customer_id"><I>customer_id</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT">FK UK</TD></TR><TR><TD ALIGN="LEFT" PORT="product_id"><I>product_id</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT">FK UK</TD></TR><TR><TD ALIGN="LEFT" PORT="quantity">quantity</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="added_date">added_date</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime</FONT></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
orders [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#888888"><TR><TD COLSPAN="3" BGCOLOR="#DDF3EA"><B>ORDERS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="order_id"><B>order_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="customer_id"><I>customer_id</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="order_date">order_date</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="total_amount">total_amount</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">decimal(10,2)</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="order_status">order_status</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(30)</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="shipping_addr">shipping_addr</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255)</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="delivery_date">delivery_date</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime</FONT></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
order_items [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#888888"><TR><TD COLSPAN="3" BGCOLOR="#DDF3EA"><B>ORDER_ITEMS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="order_item_id"><B>order_item_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="order_id"><I>order_id</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="product_id"><I>product_id</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="quantity">quantity</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="unit_price">unit_price</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">decimal(10,2)</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="subtotal">subtotal</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">decimal(10,2)</FONT></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
payments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#888888"><TR><TD COLSPAN="3" BGCOLOR="#DDF3EA"><B>PAYMENTS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="payment_id"><B>payment_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="order_id"><I>order_id</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="payment_method">payment_method</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(30)</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="amount">amount</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">decimal(10,2)</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="payment_date">payment_date</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="payment_status">payment_status</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(30)</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="transaction_id">transaction_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(100)</FONT></TD><TD ALIGN="LEFT">UK</TD></TR></TABLE>>];
reviews [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#888888"><TR><TD COLSPAN="3" BGCOLOR="#DDF3EA"><B>REVIEWS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="review_id"><B>review_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="customer_id"><I>customer_id</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="product_id"><I>product_id</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="rating">rating</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="review_text">review_text</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(500)</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="review_date">review_date</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime</FONT></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
user_sessions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#888888"><TR><TD COLSPAN="3" BGCOLOR="#E3EEFB"><B>USER_SESSIONS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="session_id"><B>session_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="customer_id"><I>customer_id</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="start_time">start_time</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="end_time">end_time</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="device_type">device_type</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(50)</FONT></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
product_views [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#888888"><TR><TD COLSPAN="3" BGCOLOR="#E3EEFB"><B>PRODUCT_VIEWS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="view_id"><B>view_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="customer_id"><I>customer_id</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="product_id"><I>product_id</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="session_id"><I>session_id</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="view_timestamp">view_timestamp</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime</FONT></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
cart_events [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#888888"><TR><TD COLSPAN="3" BGCOLOR="#E3EEFB"><B>CART_EVENTS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="event_id"><B>event_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="customer_id"><I>customer_id</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="product_id"><I>product_id</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="cart_id"><I>cart_id</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="event_type">event_type</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(30)</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="event_timestamp">event_timestamp</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime</FONT></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
funnel_events [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#888888"><TR><TD COLSPAN="3" BGCOLOR="#E3EEFB"><B>FUNNEL_EVENTS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="event_id"><B>event_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="customer_id"><I>customer_id</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="session_id"><I>session_id</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="product_id"><I>product_id</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="event_stage">event_stage</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(30)</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="event_timestamp">event_timestamp</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime</FONT></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="order_id"><I>order_id</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT">FK</TD></TR></TABLE>>];
customers -> cart:customer_id:w [dir=both, arrowhead=crow, arrowtail=teetee];
products -> cart:product_id:w [dir=both, arrowhead=crow, arrowtail=teetee];
cart -> cart_events:cart_id:w [dir=both, arrowhead=crowodot, arrowtail=teeodot];
customers -> cart_events:customer_id:w [dir=both, arrowhead=crow, arrowtail=teetee];
products -> cart_events:product_id:w [dir=both, arrowhead=crow, arrowtail=teetee];
customers -> funnel_events:customer_id:w [dir=both, arrowhead=crow, arrowtail=teetee];
orders -> funnel_events:order_id:w [dir=both, arrowhead=crowodot, arrowtail=teeodot];
products -> funnel_events:product_id:w [dir=both, arrowhead=crowodot, arrowtail=teeodot];
user_sessions -> funnel_events:session_id:w [dir=both, arrowhead=crowodot, arrowtail=teeodot];
customers -> orders:customer_id:w [dir=both, arrowhead=crow, arrowtail=teetee];
orders -> order_items:order_id:w [dir=both, arrowhead=crow, arrowtail=teetee];
products -> order_items:product_id:w [dir=both, arrowhead=crow, arrowtail=teetee];
orders -> payments:order_id:w [dir=both, arrowhead=crow, arrowtail=teetee];
sellers -> products:seller_id:w [dir=both, arrowhead=crowodot, arrowtail=teeodot];
customers -> product_views:customer_id:w [dir=both, arrowhead=crow, arrowtail=teetee];
products -> product_views:product_id:w [dir=both, arrowhead=crow, arrowtail=teetee];
user_sessions -> product_views:session_id:w [dir=both, arrowhead=crow, arrowtail=teetee];
customers -> reviews:customer_id:w [dir=both, arrowhead=crow, arrowtail=teetee];
products -> reviews:product_id:w [dir=both, arrowhead=crow, arrowtail=teetee];
customers -> user_sessions:customer_id:w [dir=both, arrowhead=crow, arrowtail=teetee];

{rank=same; sellers; customers; admin;}
}